
---
import "../styles/notecard.css";

interface Props {
  title: string;
  description: string;
  date: Date | string;
  lastModified?: Date | string;
  category?: string;
  href?: string;
}

const {
  title,
  description,
  date,
  lastModified,
  category,
  href = "#",
} = Astro.props;

const formatDate = (value: Date | string) => {
  const parsedDate = value instanceof Date
    ? value
    : new Date(value);

  return parsedDate.toLocaleDateString("es-PE", {
    timeZone: "UTC",
    day: "numeric",
    month: "short",
    year: "numeric",
  });
};

const formattedDate = formatDate(date);
const formattedLastModified = lastModified
  ? formatDate(lastModified)
  : null;
---

<article class="note-card">

  <div class="note-icon" aria-hidden="true">
    📝
  </div>

  <div class="note-card-main">

    <a href={href} class="note-title">
      {title}
    </a>

    <p class="note-description">
      {description}
    </p>

    <div class="note-meta">

      {category && (
        <span class="note-category">
          {category}
        </span>
      )}

      <span class="note-date">
        {formattedDate}
      </span>

    </div>

    {formattedLastModified && (
      <span class="note-updated">
        ↻ Actualizado: {formattedLastModified}
      </span>
    )}

  </div>

  <a
    href={href}
    class="note-arrow"
    aria-label={`Leer ${title}`}
  >
    →
  </a>

</article>

<style>
  .note-updated {
    display: block;
    margin-top: 5px;
    color: var(--color-success);
    font-size: 0.78rem;
  }
</style>
