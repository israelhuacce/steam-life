---
import "../styles/hero.css";
---

<section class="hero">

    <!-- PORTADA -->
    <div class="hero-cover">
        <img
            src="/images/portada.jpg"
            alt="Portada"
        />
    </div>

    <!-- PERFIL -->
    <div class="hero-profile">
        <img
            src="/images/profile.png"
            alt="Israel Huacce"
        />
    </div>

    <!-- INFORMACIÓN DEL PERFIL -->
    <div class="hero-content">

        <h1>Israel Huacce</h1>

        <p class="hero-username">
            @israelhuacce
        </p>
<div class="hero-info">

    <span class="hero-location">
        📍 Ayacucho, Perú
    </span>

    <a
        class="hero-github"
        href="https://github.com/israelhuacce"
        target="_blank"
        rel="noopener noreferrer"
    >
        🔗 GitHub
    </a>

</div>

        <div class="hero-actions">

            <a
                class="hero-button primary"
                href="/notas"
            >
                Explorar notas
            </a>

            <a
                class="hero-button"
                href="/proyectos"
            >
                Ver proyectos
            </a>

        </div>

        <div class="hero-tags">


        <a
            href="https://www.goodreads.com/user/show/146018942-israel-huacce"
            target="_blank"
            rel="noopener noreferrer"
    >
        📚 Libros
    </a>

    <a
        href="https://myanimelist.net/profile/izragg"
        target="_blank"
        rel="noopener noreferrer"
    >
        🎬 Anime
    </a>

    <a
        href="https://steamcommunity.com/profiles/76561198153710108/"
        target="_blank"
        rel="noopener noreferrer"
    >
        🎮 Juegos
    </a>

    <a
        href="https://open.spotify.com/user/22tn7kefwsdpq4uyvbkaiuxua?si=247a773de9dc4c85"
        target="_blank"
        rel="noopener noreferrer"
    >
        🎵 Música
    </a>

        </div>

    </div>

</section>