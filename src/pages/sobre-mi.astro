---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/about.css";
---

<BaseLayout title="Sobre mí">

  <main class="about-page">

    <!-- ENCABEZADO -->
    <header class="about-header">

      <a href="/" class="back-link">
        ← Volver al inicio
      </a>

      <span class="about-label">
        SOBRE MÍ
      </span>

      <h1>Hola, soy Israel.</h1>

      <p class="about-intro">
        Aprendiendo entre números, código, música y muchas ideas.
      </p>

    </header>


    <!-- PRESENTACIÓN -->
    <section class="about-section">

      <div class="section-heading">
        <span class="section-number">01</span>
        <h2>Un poco sobre mí</h2>
      </div>

      <div class="about-content">

        <p>
          Soy Bachiller en Contabilidad y Auditoría y actualmente continúo
          desarrollándome profesionalmente en el campo de la auditoría,
          la contabilidad y la gestión financiera.
        </p>

        <p>
          Siempre me ha llamado la atención la tecnología. Me gusta probar herramientas nuevas, aprender por mi cuenta y descubrir qué puedo hacer con ellas.
        </p>

        <p>
          Aquí reúno cosas que aprendo, proyectos en los que trabajo, ideas que me interesan y descubrimientos que quiero conservar.
        </p>

      </div>

    </section>


    <!-- ACTUALMENTE -->
    <section class="about-section">

      <div class="section-heading">
        <span class="section-number">02</span>
        <h2>Actualmente</h2>
      </div>

      <div class="timeline">

        <article class="timeline-item">

          <span class="timeline-dot"></span>

          <div>
            <span class="timeline-label">
              EDUCACIÓN
            </span>

            <h3>Maestría en Auditoría Integral</h3>

            <p>
              Continuando mi formación académica y profundizando
              conocimientos relacionados con auditoría y control.
            </p>
          </div>

        </article>


        <article class="timeline-item">

          <span class="timeline-dot"></span>

          <div>
            <span class="timeline-label">
              PROFESIÓN
            </span>

            <h3>Contabilidad y Auditoría</h3>

            <p>
              Desarrollando experiencia en procesos contables,
              tributarios, financieros y de gestión.
            </p>
          </div>

        </article>


        <article class="timeline-item">

          <span class="timeline-dot"></span>

          <div>
            <span class="timeline-label">
              TECNOLOGÍA
            </span>

            <h3>Aprendiendo desarrollo web</h3>

            <p>
              Explorando Astro, Git, JavaScript, Python, Docker
              y diferentes herramientas para construir proyectos.
            </p>
          </div>

        </article>

      </div>

    </section>


    <!-- INTERESES -->
    <section class="about-section">

      <div class="section-heading">
        <span class="section-number">03</span>
        <h2>Mis intereses</h2>
      </div>

      <div class="interests-grid">

        <article class="interest-card">
          <span class="interest-icon">📊</span>
          <h3>Contabilidad</h3>
          <p>
            Contabilidad, auditoría, tributación y análisis financiero.
          </p>
        </article>

        <article class="interest-card">
          <span class="interest-icon">💻</span>
          <h3>Tecnología</h3>
          <p>
            Desarrollo web, software, Linux y herramientas digitales.
          </p>
        </article>

        <article class="interest-card">
          <span class="interest-icon">🎵</span>
          <h3>Música</h3>
          <p>
            Guitarra, bajo, grabación y descubrir nueva música.
          </p>
        </article>

        <article class="interest-card">
          <span class="interest-icon">📚</span>
          <h3>Conocimiento</h3>
          <p>
            Lectura, notas, Obsidian y sistemas para organizar ideas.
          </p>
        </article>

      </div>

    </section>


    <!-- CIERRE -->
    <section class="about-closing">

      <div class="closing-icon">
        🌱
      </div>

      <h2>Siempre aprendiendo.</h2>

      <p>
        Este sitio es una pequeña representación de lo que estoy
        aprendiendo, construyendo y descubriendo en el camino.
      </p>

    </section>


  </main>

</BaseLayout>